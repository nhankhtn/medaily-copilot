{
  "manifest_version": 3,
  "name": "Medaily Copilot",
  "version": "0.1.6",
  "description": "Floating page assistant that answers questions about the current page via medaily-ai.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>", "https://ai.medaily.id.vn/*"],
  "action": {
    "default_title": "Medaily Copilot",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/chatbox.js"],
      "css": ["content/chatbox.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
